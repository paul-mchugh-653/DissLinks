            textNode("Name: ") +* input(type("text") +@ onKeyUp(fun(str) { ArtistName(str) } ), MvuHTML.empty) +* textNode("(Required)")
        ) +*
        div(a0,
            (textNode("Genre: ") +* input(type("text") +@ onKeyUp(fun(str) { ArtistGenre(str) } ), MvuHTML.empty)) +*  input(type("checkbox") +@ onClick(fun() { ArtistGenreNull(not(model.genreNull)) }), MvuHTML.empty) +* textNode("(Set null)")
        ) +*
        div(a0,
            (textNode("Members: ") +* input(type("text") +@ onKeyUp(fun(str) { ArtistMembers(str) } ), MvuHTML.empty)) +* input(type("checkbox") +@ onClick(fun() { ArtistMembersNull(not(model.membersNull)) }), MvuHTML.empty) +* textNode("(Set null)")
        ) +*
        div(a0,
            (textNode("Active: ") +* input(type("checkbox") +@ onClick(fun() { ArtistActive(not(model.selectedArtist.active)) }), MvuHTML.empty)) +*  input(type("checkbox") +@ onClick(fun() { ArtistActiveNull(not(model.activeNull)) }), MvuHTML.empty) +* textNode("(Set null)")
        ) +*
        div(a0,
            (textNode("Score: ") +* input(type("text") +@ onKeyUp(fun(str) { ArtistScore(str) } ), MvuHTML.empty)) +*  input(type("checkbox") +@ onClick(fun() { ArtistScoreNull(not(model.scoreNull)) }), MvuHTML.empty) +* textNode("(Set null)")
        )
    ) +*
    div(a0,
		button(onClick(fun() { InsertArtist() } ), textNode("Insert"))
	)
}

