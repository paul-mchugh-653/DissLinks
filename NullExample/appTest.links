        ) +*
        div(a0,
            (textNode("Artist ID: ") +* input(type("text") +@ value(model.selectedSong.artist_id) +@ onKeyUp(fun(str) { SongArtistID(str) } ), MvuHTML.empty)) +*  input(type("checkbox") +@ checked(model.songArtistIDNull) +@ onClick(fun() { SongArtistIDNull(not(model.songArtistIDNull)) }), MvuHTML.empty) +* textNode("(Set null)")
        ) +*
        div(a0,
            (textNode("Runtime: ") +* input(type("text") +@ value(model.selectedSong.runtime) +@ onKeyUp(fun(str) { SongRuntime(str) } ), MvuHTML.empty)) +* input(type("checkbox") +@ checked(model.songRuntimeNull) +@ onClick(fun() { SongRuntimeNull(not(model.songRuntimeNull)) }), MvuHTML.empty) +* textNode("(Set null)")
        ) +*
        div(a0,
            (textNode("Lyrics: ")  +* input(type("checkbox") +@ checked(model.selectedSong.lyrics) +@ onClick(fun() { SongLyrics(not(model.selectedSong.lyrics)) }), MvuHTML.empty)) +*  input(type("checkbox") +@ checked(model.songLyricsNull) +@ onClick(fun() { SongLyricsNull(not(model.songLyricsNull)) }), MvuHTML.empty) +* textNode("(Set null)")
        ) 
    ) +*
    div(a0,
        button(onClick(fun() { UpdateSong() } ), textNode("Update by ID")) +* button(onClick(fun() { DeleteSong() } ), textNode("Delete by ID"))
    ) 


}



sig view : (Model) ~%~> MvuHTML.HTML(Message)                   
fun view(model) {

    open MvuHTML;
    open MvuAttrs;

    var text =
        switch(model.state){
            case NotStarted -> div(a0, textNode("Not Started"))
            case Waiting -> div(a0, textNode("Waiting"))
            case SelectArtistDone(result) -> insert_artist(model) +* unpack_artist(result)
            case ArtistFilterPage -> filter_artist(model)
            case SongFilterPage -> filter_song(model)
            case SelectArtistFilterDone(result) -> filter_artist(model) +* unpack_artist(result)
            case SelectSongFilterDone(result) -> filter_song(model) +* unpack_song(result)
            case SelectSongDone(result) -> insert_song(model) +* unpack_song(result) 
            case ExpandedArtist(result) -> expand_artist(model, result)
            case ExpandedSong -> expand_song(model) 
            case InsertDone -> div(a0, textNode("Inserted"))
            case DeleteDone -> div(a0, textNode("Deleted"))
            case UpdateDone -> div(a0, textNode("Updated"))
        };
    
    h1(style("display: flex; justify-content: center; align-items: center;"), textNode("Music Database Example Application")) +*
    div(style("display: flex; justify-content: center; align-items: center; margin: 10px"),
        div(a0, button( onClick(fun() { SelectAllArtists }), textNode("Artist List") )) +* br(a0, MvuHTML.empty) +*
        div(a0, button( onClick(fun() { SelectAllSongs }), textNode("Song List") )) +* br(a0, MvuHTML.empty) +*
        div(a0, button( onClick(fun() { ToArtistFilterPage }), textNode("Artist Filter") )) +* br(a0, MvuHTML.empty) +*
        div(a0, button( onClick(fun() { ToSongFilterPage }), textNode("Song Filter") ))
    ) +*
    div(a0, text)

}  

fun selectAllArtists() server {

    query{
        for (a <-- artists)
            [a]
    }
}

fun searchByGenre(model) server {

    var genre = if (model.filterArtistGenreNull)
            Nothing
        else
            Just(model.filterArtistGenre); 

    query{
        for (a <-- artists)
        where(a.genre == genre) 
            [a]
    }

}

fun searchByMembers(model) server {

    var members = if (model.filterMembersNull)
            Nothing
        else
            Just(stringToInt(model.filterMembers)); 

    query{
        for (a <-- artists)
        where(a.members == members) 
            [a]
    }

}

fun searchByGenreMembers(model) server {

    var genre = if (model.filterArtistGenreNull)
            Nothing
        else
            Just(model.filterArtistGenre);

    var members = if (model.filterMembersNull)
            Nothing
        else
            Just(stringToInt(model.filterMembers));

    query{
        for (a <-- artists)
        where((a.genre == genre) && (a.members == members))
            [a]
    }

}

fun selectArtistSongs(model) server {

    query{
        for (s <-- songs)
        where((s.artist_id == Just(model.selectedArtist.id)))
            [s]
    }
}

fun selectAllSongs(model) server {

    query{
        for (s <-- songs)
            [s]
    }
}

fun searchByGreaterRuntime(model) server {

    var runtime = if (model.filterRuntimeNull)
            Nothing
        else
            Just(stringToFloat(model.filterRuntime));
    query{
        for (s <-- songs)
        where (s.runtime > runtime)
            [s]
    }

}

fun searchByLessRuntime(model) server {

    var runtime = if (model.filterRuntimeNull)
            Nothing
        else
            Just(stringToFloat(model.filterRuntime));
    query{
        for (s <-- songs)
        where (s.runtime < runtime)
            [s]
    }
}

fun searchByLyrics(model) server {

    var lyrics = if (model.filterLyricsNull)
            Nothing
        else
            Just(model.filterLyrics);

    query{
        for (s <-- songs)
        where (s.lyrics == lyrics)
            [s]
    }

}

fun searchSongByGenre(model) server {

    var genre = if (model.filterSongGenreNull)
            Nothing
        else
            Just(model.filterSongGenre);

    query{
        for(s <-- songs)
        for(a <-- artists)
        where (Just(a.id) == s.artist_id && a.genre == genre)
            [s]
    }

}

sig deleteArtist : (Model) ~%~> ()
fun deleteArtist(model) server {

    delete (a <-- artists) where (a.id == model.selectedArtist.id)

}

sig deleteSong : (Model) ~%~> ()
fun deleteSong(model) server {

    delete (s <-- songs) where (s.id == model.selectedSong.id)

}


sig insertArtist : (Model) ~%~> ()
fun insertArtist(model) server {

    var genre = if (model.genreNull)
            Nothing
        else
            Just(model.selectedArtist.genre);

    var members = if (model.membersNull)
            Nothing
        else
            Just(stringToInt(model.selectedArtist.members));

    var active = if (model.activeNull)
            Nothing
        else
            Just(model.selectedArtist.active);

    var score = if (model.scoreNull)
            Nothing
        else
            Just(stringToFloat(model.selectedArtist.score));

    insert artistsNoID
    values (name, genre, members, active, score) [(name = model.selectedArtist.name, genre = genre, members = members, active = active, score = score)]

}

sig insertSong : (Model) ~%~> ()
fun insertSong(model) server {

    var name = if (model.songNameNull)
            Nothing
        else
            Just(model.selectedSong.name);

    var artist_id = if (model.songArtistIDNull)
            Nothing
        else
            Just(stringToInt(model.selectedSong.artist_id));

    var runtime = if (model.songRuntimeNull)
            Nothing
        else
            Just(stringToFloat(model.selectedSong.runtime));

    var lyrics = if (model.songLyricsNull)
            Nothing
        else
            Just(model.selectedSong.lyrics);

    insert songsNoID
    values (name, artist_id, runtime, lyrics) [(name = name, artist_id = artist_id, runtime = runtime, lyrics = lyrics)]

}

sig updateArtist : (Model) ~%~> ()
fun updateArtist(model) server {

    var genre = if (model.genreNull)
            Nothing
        else
            Just(model.selectedArtist.genre);

    var members = if (model.membersNull)
            Nothing
        else
            Just(stringToInt(model.selectedArtist.members));

    var active = if (model.activeNull)
            Nothing
        else
            Just(model.selectedArtist.active);

    var score = if (model.scoreNull)
            Nothing
        else
            Just(stringToFloat(model.selectedArtist.score));

    update (a <-- artists)
    where (a.id == model.selectedArtist.id)
    set (name = model.selectedArtist.name, genre = genre, members = members, active = active, score = score)

}

sig updateSong : (Model) ~%~> ()
fun updateSong(model) server {

    var name = if (model.songNameNull)
            Nothing
        else
            Just(model.selectedSong.name);

    var artist_id = if (model.songArtistIDNull)
            Nothing
        else
            Just(stringToInt(model.selectedSong.artist_id));

    var runtime = if (model.songRuntimeNull)
            Nothing
        else
            Just(stringToFloat(model.selectedSong.runtime));

    var lyrics = if (model.songLyricsNull)
            Nothing
        else
            Just(model.selectedSong.lyrics);

    update (s <-- songs)
    where (s.id == model.selectedSong.id)
    set (name = name, artist_id = artist_id, runtime = runtime, lyrics = lyrics)

}


sig updt : (Message, Model) ~%~> (Model, MvuCommands.Command(Message))
fun updt(msg, model) {

    switch(msg){
        case SelectAllArtists -> 
            var cmd = MvuCommands.spawnProc(fun() { SelectArtistFinished(selectAllArtists()) });
            ((model with state = Waiting, selectedArtist = (id = 0, name = "", genre = "", members = "", active = false, score = "")), cmd)
        case SelectAllSongs -> 
            var cmd = MvuCommands.spawnProc(fun() { SelectSongFinished(selectAllSongs(model)) });
            ((model with state = Waiting, selectedSong = (id = 0, name = "", artist_id = "", runtime = "", lyrics = false)), cmd)
        case SelectArtistGenre ->
            var cmd = MvuCommands.spawnProc(fun() { SelectArtistFilterFinished(searchByGenre(model)) });
            ((model with state = Waiting), cmd)
        case SelectArtistMembers ->
            var cmd = MvuCommands.spawnProc(fun() { SelectArtistFilterFinished(searchByMembers(model)) });
            ((model with state = Waiting), cmd)
        case SelectArtistGenreMembers ->
            var cmd = MvuCommands.spawnProc(fun() { SelectArtistFilterFinished(searchByGenreMembers(model)) });
            ((model with state = Waiting), cmd)
        case SelectSongRuntimeGreater ->
            var cmd = MvuCommands.spawnProc(fun() { SelectSongFilterFinished(searchByGreaterRuntime(model)) });
            ((model with state = Waiting), cmd)
        case SelectSongRuntimeLess ->
            var cmd = MvuCommands.spawnProc(fun() { SelectSongFilterFinished(searchByLessRuntime(model)) });
            ((model with state = Waiting), cmd)
        case SelectSongLyrics ->
            var cmd = MvuCommands.spawnProc(fun() { SelectSongFilterFinished(searchByLyrics(model)) });
            ((model with state = Waiting), cmd)
        case SelectSongGenre ->
            var cmd = MvuCommands.spawnProc(fun() { SelectSongFilterFinished(searchSongByGenre(model)) });
            ((model with state = Waiting), cmd)
        case InsertArtist() ->
            var cmd = MvuCommands.spawnProc(fun() { InsertFinished(insertArtist(model)) });
            ((model with state = Waiting), cmd)
        case InsertSong() ->
            var cmd = MvuCommands.spawnProc(fun() { InsertFinished(insertSong(model)) });
            ((model with state = Waiting), cmd)
        case DeleteArtist() ->
            var cmd = MvuCommands.spawnProc(fun() { DeleteFinished(deleteArtist(model)) });
            ((model with state = Waiting), cmd)
        case DeleteSong() ->
            var cmd = MvuCommands.spawnProc(fun() { DeleteFinished(deleteSong(model)) });
            ((model with state = Waiting), cmd)
        case UpdateArtist() ->
            var cmd = MvuCommands.spawnProc(fun() { UpdateFinished(updateArtist(model)) });
            ((model with state = Waiting), cmd)
        case UpdateSong() ->
            var cmd = MvuCommands.spawnProc(fun() { UpdateFinished(updateSong(model)) });
            ((model with state = Waiting), cmd)
        case SelectArtistFinished(result) -> ((model with state = SelectArtistDone(result)), MvuCommands.empty)
        case SelectSongFinished(result) -> ((model with state = SelectSongDone(result)), MvuCommands.empty)
        case SelectArtistFilterFinished(result) -> ((model with state = SelectArtistFilterDone(result)), MvuCommands.empty)
        case SelectSongFilterFinished(result) -> ((model with state = SelectSongFilterDone(result)), MvuCommands.empty)
        case InsertFinished -> ((model with state = InsertDone), MvuCommands.empty)
        case DeleteFinished -> ((model with state = DeleteDone), MvuCommands.empty)
        case UpdateFinished -> ((model with state = UpdateDone), MvuCommands.empty)
        case ArtistID(i) -> ((model with selectedArtist = (model.selectedArtist with id = i)), MvuCommands.empty)
        case ArtistName(n) -> ((model with selectedArtist = (model.selectedArtist with name = n)), MvuCommands.empty)
        case ArtistGenre(g) -> ((model with selectedArtist = (model.selectedArtist with genre = g)), MvuCommands.empty)
        case ArtistGenreNull(gn) -> ((model with genreNull = gn), MvuCommands.empty)
        case ArtistMembers(m) -> ((model with selectedArtist = (model.selectedArtist with members = m)), MvuCommands.empty)
        case ArtistMembersNull(mn) -> ((model with membersNull = mn), MvuCommands.empty)
        case ArtistActive(a) -> ((model with selectedArtist = (model.selectedArtist with active = a)), MvuCommands.empty)
        case ArtistActiveNull(an) -> ((model with activeNull = an), MvuCommands.empty)
        case ArtistScore(s) -> ((model with selectedArtist = (model.selectedArtist with score = s)), MvuCommands.empty)
        case ArtistScoreNull(sn) -> ((model with scoreNull = sn), MvuCommands.empty)
        case FilterArtistGenre(g) -> ((model with filterArtistGenre = g), MvuCommands.empty)
        case FilterArtistGenreNull(n) -> ((model with filterArtistGenreNull = n), MvuCommands.empty)
        case FilterSongGenre(g) -> ((model with filterSongGenre = g), MvuCommands.empty)
        case FilterSongGenreNull(n) -> ((model with filterSongGenreNull = n), MvuCommands.empty)
        case FilterArtistMembers(m) -> ((model with filterMembers = m), MvuCommands.empty)
        case FilterArtistMembersNull(n) -> ((model with filterMembersNull = n), MvuCommands.empty)
        case SongID(i) -> ((model with selectedSong = (model.selectedSong with id = i)), MvuCommands.empty)
        case SongName(n) -> ((model with selectedSong = (model.selectedSong with name = n)), MvuCommands.empty)
        case SongNameNull(sn) -> ((model with songNameNull = sn), MvuCommands.empty)
        case SongArtistID(ai) -> ((model with selectedSong = (model.selectedSong with artist_id = ai)), MvuCommands.empty)
        case SongArtistIDNull(ain) -> ((model with songArtistIDNull = ain), MvuCommands.empty)
        case SongRuntime(r) -> ((model with selectedSong = (model.selectedSong with runtime = r)), MvuCommands.empty)
        case SongRuntimeNull(rn) -> ((model with songRuntimeNull = rn), MvuCommands.empty)
        case SongLyrics(l) -> ((model with selectedSong = (model.selectedSong with lyrics = l)), MvuCommands.empty)
        case SongLyricsNull(ln) -> ((model with songLyricsNull = ln), MvuCommands.empty)
        case FilterSongRuntime(r) -> ((model with filterRuntime = r), MvuCommands.empty)
        case FilterSongRuntimeNull(n) -> ((model with filterRuntimeNull = n), MvuCommands.empty)
        case FilterSongLyrics(l) -> ((model with filterLyrics = l), MvuCommands.empty)
        case FilterSongLyricsNull(n) -> ((model with filterLyricsNull = n), MvuCommands.empty)
        case SelectedArtist(i, n, g, m, a, s) -> 
            var cmd = MvuCommands.spawnProc(fun() { SelectArtistSongFinished(selectArtistSongs((model with selectedArtist = (id = i, name = n, genre = g, members = m, active = a, score = s)))) });
            ((model with selectedArtist = (id = i, name = n, genre = g, members = m, active = a, score = s), state = Waiting), cmd)
        case SelectedSong(i, n, a, r, l) -> ((model with selectedSong = (id = i, name = n, artist_id = a, runtime = r, lyrics = l), state = ExpandedSong), MvuCommands.empty)
        case SelectArtistSongFinished(result) -> ((model with state = ExpandedArtist(result)), MvuCommands.empty)
        case ToArtistFilterPage -> ((model with state = ArtistFilterPage), MvuCommands.empty)
        case ToSongFilterPage -> ((model with state = SongFilterPage), MvuCommands.empty)
    }

}

fun mainPage() {
    Mvu.runCmd("placeholder", (selectedSong = (id = 0, name = "", artist_id = "", runtime = "", lyrics = false), selectedArtist = (id = 0, name = "", genre = "", members = "", active = false, score = ""), filterArtistGenre = "", filterSongGenre = "", filterMembers = "", filterRuntime = "", filterLyrics = false, genreNull = false, membersNull = false, activeNull = false, scoreNull = false, songNameNull = false, songArtistIDNull = false, songRuntimeNull = false, songLyricsNull = false, filterArtistGenreNull = false, filterSongGenreNull = false, filterMembersNull = false, filterRuntimeNull = false, filterLyricsNull = false, state = NotStarted), view, updt, MvuCommands.empty);

    page
        <html>
        <body>
        <style>
            body {{
                background-color: rgb(240, 240, 240);
            }}
        </style>
        <div id="placeholder"></div>
        </body>
        </html>

}

serveThis(mainPage)