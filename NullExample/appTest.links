sig expand_artist : (Model, [(id: Int, name: nullable String, artist_id: nullable Int, runtime: nullable Float, lyrics: nullable Bool)]) ~%~> MvuHTML.HTML(Message)
fun expand_artist(model, result){

    open MvuHTML;
    open MvuAttrs;
 
    div(style(widgetStyle),
        div(a0,
            textNode("ID: " ^^ intToString(model.selectedArtist.id))
        ) +*
        div(a0,
            textNode("Name: ") +* input(type("text") +@ value(model.selectedArtist.name) +@ onKeyUp(fun(str) { ArtistName(str) } ), MvuHTML.empty)
        ) +*
        div(a0,
            (textNode("Genre: ") +* input(type("text") +@ value(model.selectedArtist.genre) +@ onKeyUp(fun(str) { ArtistGenre(str) } ), MvuHTML.empty)) +*  input(type("checkbox") +@ checked(model.genreNull) +@ onClick(fun() { ArtistGenreNull(not(model.genreNull)) }), MvuHTML.empty) +* textNode("(Set null)")
        ) +* 
        div(a0,
            (textNode("Members: ") +* input(type("text") +@ value(model.selectedArtist.members) +@ onKeyUp(fun(str) { ArtistMembers(str) } ), MvuHTML.empty)) +* input(type("checkbox") +@ checked(model.membersNull) +@ onClick(fun() { ArtistMembersNull(not(model.membersNull)) }), MvuHTML.empty) +* textNode("(Set null)")
        ) +* 
        div(a0,
            (textNode("Active: ") +* input(type("checkbox") +@ checked(model.selectedArtist.active) +@ onClick(fun() { ArtistActive(not(model.selectedArtist.active)) }), MvuHTML.empty)) +*  input(type("checkbox") +@ checked(model.activeNull) +@ onClick(fun() { ArtistActiveNull(not(model.activeNull)) }), MvuHTML.empty) +* textNode("(Set null)")
        ) +* 
        div(a0,
            (textNode("Score: ") +* input(type("text") +@ value(model.selectedArtist.score) +@ onKeyUp(fun(str) { ArtistScore(str) } ), MvuHTML.empty)) +*  input(type("checkbox") +@ checked(model.scoreNull) +@ onClick(fun() { ArtistScoreNull(not(model.scoreNull)) }), MvuHTML.empty) +* textNode("(Set null)")
        )
    ) +* 
    div(a0,
        button(onClick(fun() { UpdateArtist() } ), textNode("Update by ID")) +* button(onClick(fun() { DeleteArtist() } ), textNode("Delete by ID"))
    ) +*
    unpack_song(result)
    


}


