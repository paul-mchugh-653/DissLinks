import MvuAttrs;
import MvuHTML;
import MvuCommands;
import Mvu;


typename Model = ( 
    selectedArtist: (id: Int, name: String, genre: String, members: String, active: Bool, score: String),
    selectedSong: (id: Int, name: String, artist_id: String, runtime: String, lyrics: Bool),
    genreNull: Bool, 
    membersNull: Bool, 
    activeNull: Bool, 
    scoreNull: Bool,
    filterArtistGenre: String,
    filterArtistGenreNull: Bool,
    filterMembers: String,
    filterMembersNull: Bool,
    songNameNull: Bool,
    songArtistIDNull: Bool,
    songRuntimeNull: Bool,
    songLyricsNull: Bool,
    filterRuntime: String,
    filterRuntimeNull: Bool,
    filterSongGenre: String,
    filterSongGenreNull: Bool,
    filterLyrics: Bool,
    filterLyricsNull: Bool,
    state: 
        [| NotStarted 
        | Waiting 
        | InsertDone 
        | DeleteDone 
        | UpdateDone 
        | ExpandedSong
        | ExpandedArtist: [(id: Int, name: nullable String, artist_id: nullable Int, runtime: nullable Float, lyrics: nullable Bool)]
        | ArtistFilterPage
        | SongFilterPage
        | SelectArtistDone: [(id: Int, name: String, genre: nullable String, members: nullable Int, active: nullable Bool, score: nullable Float)] 
        | SelectArtistFilterDone: [(id: Int, name: String, genre: nullable String, members: nullable Int, active: nullable Bool, score: nullable Float)] 
        | SelectSongDone: [(id: Int, name: nullable String, artist_id: nullable Int, runtime: nullable Float, lyrics: nullable Bool)] 
        | SelectSongFilterDone: [(id: Int, name: nullable String, artist_id: nullable Int, runtime: nullable Float, lyrics: nullable Bool)] 
        |]);


typename Message = 
[| SelectAllArtists
| SelectAllSongs 
| SelectArtistGenre
| SelectArtistMembers
| SelectArtistGenreMembers
| SelectSongRuntimeGreater
| SelectSongRuntimeLess
| SelectSongLyrics
| SelectSongGenre
| InsertArtist: ()
| InsertSong: ()
| DeleteArtist: ()
| DeleteSong: ()
| UpdateArtist: ()
| UpdateSong: ()
| ArtistID: Int
| ArtistName: String 
| ArtistGenre: String 
| ArtistGenreNull: Bool
| ArtistMembers: String 
| ArtistMembersNull: Bool
| ArtistActive: Bool 
| ArtistActiveNull: Bool
| ArtistScore: String 
| ArtistScoreNull: Bool
| FilterArtistGenre: String
| FilterArtistGenreNull: Bool
| FilterSongGenre: String
| FilterSongGenreNull: Bool
| FilterArtistMembers: String
| FilterArtistMembersNull: Bool
| SongID: Int
| SongName: String
| SongNameNull: Bool
| SongArtistID: String
| SongArtistIDNull: Bool
| SongRuntime: String
| SongRuntimeNull: Bool
| SongLyrics: Bool
| SongLyricsNull: Bool
| FilterSongRuntime: String
| FilterSongRuntimeNull: Bool
| FilterSongLyrics: Bool
| FilterSongLyricsNull: Bool
| SelectedArtist: (Int, String, String, String, Bool, String)
| SelectedSong: (Int, String, String, String, Bool)
| InsertFinished: () 
| DeleteFinished: ()
| UpdateFinished: ()
| SelectArtistSongFinished: [(id: Int, name: nullable String, artist_id: nullable Int, runtime: nullable Float, lyrics: nullable Bool)]
| SelectArtistFinished: [(id: Int, name: String, genre: nullable String, members: nullable Int, active: nullable Bool, score: nullable Float)] 
| SelectArtistFilterFinished: [(id: Int, name: String, genre: nullable String, members: nullable Int, active: nullable Bool, score: nullable Float)] 
| SelectSongFinished:[(id: Int, name: nullable String, artist_id: nullable Int, runtime: nullable Float, lyrics: nullable Bool)]
| SelectSongFilterFinished:[(id: Int, name: nullable String, artist_id: nullable Int, runtime: nullable Float, lyrics: nullable Bool)]
| ToArtistFilterPage
| ToSongFilterPage
|];

var db = database "music";

var artists = table "artist" with (id: Int, name: String, genre: nullable String, members: nullable Int, active: nullable Bool, score: nullable Float) from db;
var artistsNoID = table "artist" with (name: String, genre: nullable String, members: nullable Int, active: nullable Bool, score: nullable Float) from db;

var songs = table "song" with (id: Int, name: nullable String, artist_id: nullable Int, runtime: nullable Float, lyrics: nullable Bool) from db;
var songsNoID = table "song" with (name: nullable String, artist_id: nullable Int, runtime: nullable Float, lyrics: nullable Bool) from db;


var widgetStyle = "background-color: rgb(203, 247, 253); margin: 10px; outline-style: solid; outline-color: rgb(162, 209, 243); padding: 5px;";

sig unpack_artist : ([(id: Int, name: String, genre: nullable String, members: nullable Int, active: nullable Bool, score: nullable Float)]) ~%~> MvuHTML.HTML(Message)
fun unpack_artist(l){

        open MvuHTML;
        open MvuAttrs;

    if (l == []){
            div(a0,
                textNode("")
            )}
    else {
        var genre = switch (hd(l).genre){
            case Just(x) -> x
            case Nothing -> "Defies genres"
        };

        var members = switch (hd(l).members){
            case Just(x) -> intToString(x)
            case Nothing -> "Unknown"
        };

        var active = switch (hd(l).active){
            case Just(x) -> if (x) "true" else "false"
            case Nothing -> "Unconfirmed"
        };

        var bool_active = switch (hd(l).active){
            case Just(x) -> x
            case Nothing -> false
        };

        var score  = switch (hd(l).score){
            case Just(x) -> floatToString(x)
            case Nothing -> "Unscored"
        };

        div(style(widgetStyle) +@ onClick( fun() { SelectedArtist(hd(l).id, hd(l).name, genre, members, bool_active, score) } ),
            textNode("ID: " ^^ intToString(hd(l).id)) +* br(a0, MvuHTML.empty) +*
            textNode("Name: " ^^ hd(l).name) +* br(a0, MvuHTML.empty) +*
            textNode("Genre: " ^^ genre) +* br(a0, MvuHTML.empty) +*
            textNode("Members: " ^^ members) +* br(a0, MvuHTML.empty) +*
            textNode("Active: " ^^ active) +* br(a0, MvuHTML.empty) +*
            textNode("Score: " ^^ score) +* br(a0, MvuHTML.empty)
        ) +*
        unpack_artist(tl(l))
    }
}


sig unpack_song : ([(id: Int, name: nullable String, artist_id: nullable Int, runtime: nullable Float, lyrics: nullable Bool)]) ~%~> MvuHTML.HTML(Message)
fun unpack_song(l){

    open MvuHTML;
    open MvuAttrs;

    if (l == []){
            div(a0,
                textNode("")
            )}
    else {
        var name = switch(hd(l).name){
            case Just(x) -> x
            case Nothing -> "Untitled"
        };

        var artist_id = switch(hd(l).artist_id){
            case Just(x) -> intToString(x)
            case Nothing -> "Unknown Artist"
        };

        var runtime = switch(hd(l).runtime){
            case Just(x) -> floatToString(x)
            case Nothing -> "Unknown"
        };

        var lyrics = switch(hd(l).lyrics){
            case Just(x) -> if (x) "True" else "False"
            case Nothing -> "Unknown"
        };

        var bool_lyrics = switch(hd(l).lyrics){
            case Just(x) -> x
            case Nothing -> false
        };

         div(style(widgetStyle) +@ onClick( fun() { SelectedSong(hd(l).id, name, artist_id, runtime, bool_lyrics) } ),
            textNode("ID: " ^^ intToString(hd(l).id)) +* br(a0, MvuHTML.empty) +*
            textNode("Name: " ^^ name) +* br(a0, MvuHTML.empty) +*
            textNode("Artist ID: " ^^ artist_id) +* br(a0, MvuHTML.empty) +*
            textNode("Runtime: " ^^ runtime) +* br(a0, MvuHTML.empty) +*
            textNode("Lyrics: " ^^ lyrics) +* br(a0, MvuHTML.empty)
        ) +*
        unpack_song(tl(l))

        
    }

}

sig filter_artist : (Model) ~%~> MvuHTML.HTML(Message)
fun filter_artist(model){

    open MvuHTML;
    open MvuAttrs;

    div(style(widgetStyle),
        h2(a0, textNode("Filter Artists")) +*
        div(a0,
            (textNode("Genre: ") +* input(type("text") +@ value(model.filterArtistGenre) +@ onKeyUp(fun(str) { FilterArtistGenre(str) } ), MvuHTML.empty)) +*  input(type("checkbox") +@ checked(model.filterArtistGenreNull) +@ onClick(fun() { FilterArtistGenreNull(not(model.filterArtistGenreNull)) }), MvuHTML.empty) +* textNode("(Set null)")
        ) +*
        div(a0,
            (textNode("Members: ") +* input(type("text") +@ value(model.filterMembers) +@ onKeyUp(fun(str) { FilterArtistMembers(str) } ), MvuHTML.empty)) +*  input(type("checkbox") +@ checked(model.filterMembersNull) +@ onClick(fun() { FilterArtistMembersNull(not(model.filterMembersNull)) }), MvuHTML.empty) +* textNode("(Set null)")
        )
    ) +*
    div(a0,
		button(onClick(fun() { SelectArtistGenre() } ), textNode("Search by genre")) +* button(onClick(fun() { SelectArtistMembers() } ), textNode("Search by members")) +* button(onClick(fun() { SelectArtistGenreMembers() } ), textNode("Search by genre and members"))
	)
    
}

sig filter_song : (Model) ~%~> MvuHTML.HTML(Message)
fun filter_song(model){

    open MvuHTML;
    open MvuAttrs;

    div(style(widgetStyle),
        h2(a0, textNode("Filter Songs")) +*
        div(a0,
            (textNode("Runtime: ") +* input(type("text") +@ value(model.filterRuntime) +@ onKeyUp(fun(str) { FilterSongRuntime(str) } ), MvuHTML.empty)) +* input(type("checkbox") +@ checked(model.filterRuntimeNull) +@ onClick(fun() { FilterSongRuntimeNull(not(model.filterRuntimeNull)) }), MvuHTML.empty) +* textNode("(Set null)")
        ) +*
        div(a0,
            (textNode("Lyrics: ") +*  input(type("checkbox") +@ checked(model.filterLyrics) +@ onClick(fun() { FilterSongLyrics(not(model.filterLyrics)) }), MvuHTML.empty)) +* input(type("checkbox") +@ checked(model.filterLyricsNull) +@ onClick(fun() { FilterSongLyricsNull(not(model.filterLyricsNull)) }), MvuHTML.empty) +* textNode("(Set null)")
        ) +*
        div(a0,
            (textNode("Genre: ") +* input(type("text") +@ value(model.filterSongGenre) +@ onKeyUp(fun(str) { FilterSongGenre(str) } ), MvuHTML.empty)) +* input(type("checkbox") +@ checked(model.filterSongGenreNull) +@ onClick(fun() { FilterSongGenreNull(not(model.filterSongGenreNull)) }), MvuHTML.empty) +* textNode("(Set null)")
        )
    ) +*
    div(a0,
		button(onClick(fun() { SelectSongRuntimeGreater() } ), textNode("Search by runtime >")) +* button(onClick(fun() { SelectSongRuntimeLess() } ), textNode("Search by runtime <")) +* button(onClick(fun() { SelectSongLyrics() } ), textNode("Search by Lyrics")) +* button(onClick(fun() { SelectSongGenre() } ), textNode("Search by genre"))
    )
    
}

