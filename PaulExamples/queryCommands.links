import MvuAttrs;
import MvuHTML;
import MvuCommands;
import Mvu;

typename Model = (name : String, age: Int, state: [| NotStarted | Waiting | InsertDone | DeleteDone | SelectDone: [(name: String, age: Int)] |]);
typename Message = [| Insert: (String, Int) | Delete: String | Select | InsertFinished:() | DeleteFinished:() | SelectFinished:[(name: String, age: Int)] | Name: String | Age: String |];

var db = database "linkslearn";
var people = table "people" with (name: String, age: Int) from db;

sig unpack : (String, [(name: String, age: Int)]) ~%~> String
fun unpack(t, l){

        if (l == [])
                ""
        else
                hd(l).name ^^ " " ^^ intToString(hd(l).age) ^^ " | \n" ^^ unpack(t, tl(l))

}



sig view : (Model) ~%~> MvuHTML.HTML(Message)
fun view(model) {
	open MvuAttrs;
	open MvuHTML;

	var text =
        switch(model.state) {
                case NotStarted -> "Not Started"
                case Waiting -> "Waiting"
                case InsertDone -> "Inserted"
                case DeleteDone -> "Deleted"
                case SelectDone(result) -> unpack("", result)
        };

	div(a0,
                input(type("text") +@ onKeyUp(fun(str) { Name(str) } ), MvuHTML.empty)
        ) +*
	div(a0,
		input(type("text") +@ onKeyUp(fun(str) { Age(str) }), MvuHTML.empty)
	) +*
	div(a0,
		button(onClick(fun () { Delete(model.name) }), textNode("Delete"))
	) +*
	div(a0,
		button(onClick(fun() { Insert(model.name, model.age) }), textNode("Insert"))
	) +*
        div(a0,
                button(onClick(fun() { Select }), textNode("Select"))
        ) +*
	div(a0,
		textNode(text)
	) +*
	div(a0,
		textNode(model.name)
	)

}

sig insertTry : (String, Int) ~%~> ()
fun insertTry(n, a) server {
	insert people values (name, age) [(name = n, age = a)]

}

sig deleteTry : (String) ~%~> ()
fun deleteTry(n) server {
	delete (r <-- people) where (r.name == n)
}

fun selectTry() server {
	query{
		for (p <-- people)
		where(p.age > 20)
        		[p]
	}
}

sig updt : (Message, Model) ~%~> (Model, MvuCommands.Command(Message))
fun updt(msg, model) {
	switch(msg) {
		case Insert(n, a) -> 
			var cmd = 
				MvuCommands.spawnProc(fun () { InsertFinished(insertTry(n, a)) });
		((name = model.name, age = model.age, state = Waiting), cmd)
		case Delete(n) -> 
			var cmd = 
				MvuCommands.spawnProc(fun() { DeleteFinished(deleteTry(n)) });
		((name = model.name, age = model.age, state = Waiting), cmd)
		case Select ->
			var cmd = 
				MvuCommands.spawnProc(fun() { SelectFinished(selectTry()) });
		((name = model.name, age = model.age, state = Waiting), cmd)
		case InsertFinished -> ((name = model.name, age = model.age, state = InsertDone), MvuCommands.empty)
		case DeleteFinished -> ((name = model.name, age = model.age, state = DeleteDone), MvuCommands.empty)
		case SelectFinished(result) -> ((name = model.name, age = model.age, state = SelectDone(result)), MvuCommands.empty)
		case Name(n) -> ((name = n, age = model.age, state = model.state), MvuCommands.empty)
		case Age(a) -> ((name = model.name, age = stringToInt(a), state = model.state), MvuCommands.empty)
	}
}


fun mainPage() {
	Mvu.runCmd("placeholder", (name = "", age = 0 ,state = NotStarted), view, updt, MvuCommands.empty);

	page
	<html>
	<body>
	<div id="placeholder"></div>
	</body>
	</html>
}

serveThis(mainPage)
