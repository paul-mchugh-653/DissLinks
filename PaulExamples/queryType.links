var db = database "linkslearn";

var people = table "people" with (name: String, age: Int) from db;

sig unpack : (String, [(name: String, age: Int)]) ~%~> String
fun unpack(t, l){
	
	if (l == [])
		""
	else
		hd(l).name ^^ " " ^^ intToString(hd(l).age) ^^ "\n" ^^ unpack(t, tl(l))

}


fun main(){

insert people values (name, age) [(name = "Luke", age = 21)];

update (r <-- people)
where (r.name == "Luke")
set (age = 22);

delete (r <-- people)
where (r.name == "Luke");

var x = query{
for (p <-- people)
where((p.age > 20) || (p.age == 16))
        [p]
};


x
}


main()
