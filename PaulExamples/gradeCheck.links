import MvuAttrs;
import MvuHTML;
import MvuCommands;
import Mvu;


typename Model = (course: String, grade: nullable String, state: [| NotStarted | Waiting | SelectDone: [(course: String, grade: nullable String)] |]);

typename Message = [| Select | SelectFinished: [(course: String, grade: nullable String)] | Course: String | Grade: nullable String |];


var db = database "linkstry";
var grades = table "grades" with (course: String, grade: nullable String) from db;

sig unpack : (String, [(course: String, grade: nullable String)]) ~%~> String
fun unpack(t, l){

    var gradeOutput = if (l == [])
        ""
    else {
        switch(hd(l).grade){
            case Just(x) -> x
            case Nothing -> "Grade Pending"
        }
    };

    if (l == [])
        ""
    else 
        "Course: " ^^ hd(l).course ^^ " | Grade: " ^^ gradeOutput ^^ "\n" ^^ unpack(t, tl(l))        
        

}

sig view : (Model) ~%~> MvuHTML.HTML(Message)
fun view (model) {

    open MvuAttrs;
    open MvuHTML;

    var text = 
        switch (model.state) {
            case NotStarted -> "Not Started"
            case Waiting -> "Waiting"
            case SelectDone(result) -> unpack("", result)
        };

    div(a0,
        textNode(text)
    ) +*
    div(a0,
        button(onClick(fun() { Select }), textNode("Select"))
    )

}

fun selectTry() server {
    query{
        for (g <-- grades)
            [g]
    }
}

sig updt : (Message, Model) ~%~> (Model, MvuCommands.Command(Message))
fun updt(msg, model) {

    switch(msg) {
        case Select ->
            var cmd = MvuCommands.spawnProc(fun() { SelectFinished(selectTry()) });
        ((course = model.course, grade = model.course, state = Waiting), cmd)
        case SelectFinished(result) -> ((course = model.course, grade = course.grade, state = SelectDone(result)), MvuCommands.empty)
        case Course(c) -> ((course = c, grade = model.grade, state = model.state), MvuCommands.empty)
        case Grade(g) -> ((course = model.course, grade = model.grade, state = model.state), MvuCommands.empty)
    }
}

fun mainPage() {
	Mvu.runCmd("placeholder", (course = "", grade = "", state = NotStarted), view, updt, MvuCommands.empty);

	page
	<html>
	<body>
	<div id="placeholder"></div>
	</body>
	</html>

}

serveThis(mainPage)
