import MvuAttrs;
import MvuHTML;
import MvuCommands;
import Mvu;

typename Model = (employeeid: Int, fname: String, mname: nullable String, lname: String, candrive: nullable Bool, managerid: Int, state: [| NotStarted | Waiting | SelectDone: [(employeeid: Int, fname: String, mname: nullable String, lname: String, candrive: nullable Bool, managerid: Int)] |]);

typename Message = [| Select | SelectFinished: [(employeeid: Int, fname: String, mname: nullable String, lname: String, candrive: nullable Bool, managerid: Int)] |];

var db = database "example_company";
var employees = table "employees" with (employeeid: Int, fname: String, mname: nullable String, lname: String, candrive: nullable Bool, managerid: Int) from db;
var managers = table "managers" with (managerid: Int, fname: String, mname: nullable String, lname: String) from db;


sig unpack : (String, [(employeeid: Int, fname: String, mname: nullable String, lname: String, candrive: nullable Bool, managerid: Int)]) ~%~> String
fun unpack(t, l){

    var middleName = if (l == []){
        ""
    }
    else {
        switch(hd(l).mname){
            case Just(x) -> x
            case Nothing(_) -> ""
        }
    };

    var driving = if (l == []){
        ""
    }
    else {
        switch(hd(l).candrive){
            case Just(x) -> (if (x){"Can Drive"} else {"Cannot drive"})
            case Nothing(_) -> "Driving ability unknown"
        }
    };

    if (l == []){
        ""
    }
    else {
        "EmployeeID: " ^^ intToString(hd(l).employeeid) ^^ " | Name: " ^^ hd(l).fname ^^ " " ^^ middleName ^^ " " ^^ hd(l).lname ^^ " | " ^^ driving ^^ " | ID of manager: " ^^ intToString(hd(l).managerid) ^^ "\n" ^^ unpack(t, tl(l))
    }

}

sig view : (Model) ~%~> MvuHTML.HTML(Message)
fun view(model){

    open MvuAttrs;
    open MvuHTML;

    var text = 
        switch(model.state){
            case NotStarted -> "NotStarted"
            case Waiting -> "Waiting"
            case SelectDone(result) -> unpack("", result)
        };

    div(a0,
        textNode(text)
    ) +*
    div(a0,
        button(onClick(fun() { Select }), textNode("Select"))
    ) 

}

fun selectTry() server {
    query{
        for (e <-- employees)
            [e]
    }
}

fun selectConnectedTry() server {

	query{
	    for (m <-- managers)
	    	for (e <-- employees)
	   	where (m.employeeid == e.managerid)
			[(efname = e.fname, emname = e.mname, elname = e.lname, mfname = m.fname, mmname = m.mname, mlname = m.lname)]

	}

}

sig updt : (Message, Model) ~%~> (Model, MvuCommands.Command(Message))
fun updt(msg, model) {

    switch(msg) {
        case Select ->
            var cmd = MvuCommands.spawnProc(fun() { SelectFinished(selectTry())});
            ((employeeid = model.employeeid, fname = model.fname, mname = model.mname, lname = model.lname, candrive = model.candrive, managerid = model.managerid, state = Waiting), cmd)
        case SelectFinished(result) -> ((model with state = SelectDone(result)), MvuCommands.empty)
    }

}

fun mainPage() {
	Mvu.runCmd("placeholder", (employeeid = 0, fname = "", mname = Just(""), lname = "", candrive = Just(false), managerid = 0, state = NotStarted), view, updt, MvuCommands.empty);

	page
	<html>
	<body>
	<div id="placeholder"></div>
	</body>
	</html>

}

serveThis(mainPage)
